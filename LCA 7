#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n;
    int sum = 0;

    if (scanf("%d", &n) != 1 || n < 1 || n > 1000) {
        return 1;
    }

    int *arr = malloc(n * sizeof *arr);
    if (arr == NULL) {
        return 1;
    }

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 1;
        }
    }

    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }

    printf("%d\n", sum);
    free(arr);

    return 0;
}
